{
  "name": "patents-mcp-server",
  "version": "1.0.4",
  "description": "FastMCP TypeScript patent intelligence MCP server \u2014 55 tools across USPTO, EPO, and BigQuery",
  "keywords": [
    "mcp",
    "patents",
    "fastmcp",
    "uspto",
    "epo",
    "patent-search"
  ],
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/sapientsai/patents-mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapientsai/patents-mcp-server"
  },
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build",
    "dev": "ts-builds dev",
    "codegen": "openapi-ts",
    "fetch-specs": "gh api repos/patent-dev/uspto-odp/contents/swagger_fixed.yaml --jq '.content' | base64 -d > src/specs/uspto-odp.yaml",
    "prepublishOnly": "pnpm validate"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.2",
    "@types/node": "^24.13.1",
    "ts-builds": "^3.0.0",
    "tsdown": "^0.22.2"
  },
  "bin": {
    "patents-mcp-server": "./dist/index.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "lib",
    "dist"
  ],
  "prettier": "ts-builds/prettier",
  "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7",
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "fast-xml-parser": "^5.8.0",
    "fastmcp": "^4.0.1",
    "functype": "^1.3.0",
    "functype-os": "^1.3.0",
    "zod": "^4.4.3"
  }
}
