{
  "name": "patents-mcp-server",
  "version": "1.2.3",
  "description": "FastMCP TypeScript patent intelligence MCP server — 55 tools across USPTO, EPO, and BigQuery",
  "mcpName": "io.github.sapientsai/patents-mcp-server",
  "keywords": [
    "mcp",
    "patents",
    "fastmcp",
    "uspto",
    "epo",
    "patent-search"
  ],
  "author": "Jordan Burke <jordan.burke@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sapientsai/patents-mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapientsai/patents-mcp-server"
  },
  "scripts": {
    "validate": "ts-builds validate",
    "ci": "ts-builds ci",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build",
    "dev": "ts-builds dev",
    "codegen": "openapi-ts",
    "fetch-specs": "gh api repos/patent-dev/uspto-odp/contents/swagger_fixed.yaml --jq '.content' | base64 -d > src/specs/uspto-odp.yaml",
    "prepublishOnly": "pnpm run ci && pnpm check:server-json",
    "sync:server-json": "node scripts/sync-server-json.mjs",
    "check:server-json": "node scripts/sync-server-json.mjs --check",
    "version": "node scripts/sync-server-json.mjs && git add server.json"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.94.5",
    "@types/node": "^24.13.4",
    "ts-builds": "^4.7.0",
    "tsdown": "^0.22.14"
  },
  "bin": {
    "patents-mcp-server": "./dist/index.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "lib",
    "dist"
  ],
  "prettier": "ts-builds/prettier",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "fast-xml-parser": "^5.11.1",
    "fastmcp": "^4.20.14",
    "functype": "^1.9.0",
    "functype-os": "^1.9.0",
    "zod": "^4.6.5"
  }
}
